LOGLEVEL=INFO
CORS=false
UNSAFE_NO_RBAC=false
PH_SERVER_MODE=dev
PH_DB_MODE=nocodb
DISCORD_BOT=false
MQTT=true
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=user # pragma: allowlist secret
MQTT_PASSWORD=pass # pragma: allowlist secret
MQTT_SHARED_SUB_GROUP=group1
PRECACHE_SIGN_IN=true
EVENT_HOOKS_ENABLED=false
EVENT_HOOKS_INCLUDE_CSV=None
EVENT_HOOKS_EXCLUDE_CSV=None
NEW_MEMBERSHIP_ENABLED=false
NEW_MEMBERSHIP_INCLUDE_CSV=None
EXCLUDED_MEMBERSHIP_TYPES=None
NOCODB_HOST=localhost
NOCODB_PORT=8080
NOCODB_SCHEME=http
PH_BOOKSTACK_URL=http://bookstack:80
PH_BOOKSTACK_API_KEY=TEST_ENV
REQUIRE_WIKI_PAGE_FOR_CLASS_SCHEDULING=false
ASANA_WEBHOOK_PURCHASE_REQUESTS_ENABLED=false
ASANA_WEBHOOK_PURCHASE_REQUESTS_TARGET_URL=https://localhost:5000/admin/asana_webhook/
SHOP_TECH_NEON_ID=3555

# Standalone OIDC service (see oidc_service/README.md)
OIDC_ISSUER=http://127.0.0.1:5002
OIDC_SESSION_SECRET=oidc_dev_session_secret # pragma: allowlist secret
OIDC_RSA_PRIVATE_KEY=
OIDC_BOOKSTACK_CLIENT_ID=bookstack
OIDC_BOOKSTACK_CLIENT_SECRET=bookstack_dev_secret # pragma: allowlist secret
OIDC_BOOKSTACK_REDIRECT_URI=http://localhost:6875/oidc/callback
OIDC_NOCODB_CLIENT_ID=nocodb
OIDC_NOCODB_CLIENT_SECRET=nocodb_dev_secret # pragma: allowlist secret
OIDC_NOCODB_REDIRECT_URI=http://localhost:9090/api/v1/oauth2/callback
